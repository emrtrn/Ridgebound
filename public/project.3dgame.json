{
  "schema": 1,
  "name": "Ridgebound",
  "type": "three-game",
  "version": "0.0.0",
  "entry": "forge:default",
  "publicDir": "public",
  "game": {
    "module": "src/game/gameModule.ts",
    "editorCatalog": "src/game/editorCatalog.ts"
  },
  "editor": {
    "defaultScene": "assets/Maps/Derekavak.level.json",
    "assetManifest": "assets/manifest.json",
    "gridSize": 0.5,
    "gridEnabled": true,
    "snapRotationDeg": 15,
    "snapRotationEnabled": true,
    "snapScale": 0.1,
    "snapScaleEnabled": true
  },
  "scripts": {
    "preview": "npm run dev",
    "build": "npm run build"
  },
  "output": {
    "distDir": "dist"
  }
}
